# =============================================================================
# yolo-shixun · 交通标志检测与人脸表情识别
#
# 整理原则：
#   1. 源码、配置、演示截图     → 入库
#   2. 部署必需的模型权重       → 入库（见第 9 节白名单）
#   3. 数据集、训练中间件产物   → 不入库
#
# ⚠️ 两条 Git 规则决定了本文件的顺序，改动时请留意：
#   (1) Git 以「最后一条匹配的规则」为准 → 放行规则必须写在忽略规则之后；
#   (2) 父目录一旦被整体忽略，Git 就不再向下遍历 → 放行要逐级往下写，
#       不能只写 `!runs/xxx/best.pt`，否则不生效。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Python 编译与打包产物
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
setup.py
ultralytics.egg-info

# -----------------------------------------------------------------------------
# 2. 虚拟环境与包管理器
# -----------------------------------------------------------------------------
.env
.venv
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/
uv.lock
.python-version

# -----------------------------------------------------------------------------
# 3. 编辑器与操作系统文件
# -----------------------------------------------------------------------------
.vscode/
.idea/
.devcontainer/
.spyproject
.DS_Store

# -----------------------------------------------------------------------------
# 4. 测试、覆盖率与类型检查缓存
# -----------------------------------------------------------------------------
.pytest_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache
.mypy_cache/
.dmypy.json
dmypy.json
mlruns/
*.log

# -----------------------------------------------------------------------------
# 5. 数据集（体积大，云端部署不需要）
# -----------------------------------------------------------------------------
/datasets

# -----------------------------------------------------------------------------
# 6. 模型权重文件：默认忽略各类权重格式
#    本项目需要随仓库发布的权重在第 9 节单独放行
# -----------------------------------------------------------------------------
weights/
*.weights
*.pt
*.ts
*.pb
*.onnx
*.engine
*.mlmodel
*.mlpackage
*.torchscript
*.tflite
*.h5
*.mnn
*_saved_model/
*_web_model/
*_openvino_model/
*_paddle_model/
*_ncnn_model/
*_imx_model/
pnnx*
*.rknn

# ultralytics 自带的测试素材
/ultralytics/assets/

# -----------------------------------------------------------------------------
# 7. 训练产物与日志：默认不入库（runs/ 的规则在第 9 节）
# -----------------------------------------------------------------------------
wandb/
args.yaml
results.csv

# -----------------------------------------------------------------------------
# 8. 图片与视频：默认忽略
#    images/upload 与 images/result 保存本地上传图和检测结果，不入库，
#    运行时由 app.py 自动创建
# -----------------------------------------------------------------------------
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.jpg
*.jpeg
*.png
*.bmp
*.tiff
*.gif
*.svg
*.webp
*.heic
*.ico
*.raw

# =============================================================================
# 9. 例外白名单（必须放在文件最后，否则会被上面的规则覆盖）
# =============================================================================

# ----- 9.1 根目录预训练权重：不随仓库发布 -------------------------------------
# yolo26n.pt 是官方 COCO 预训练权重，推理示例脚本首次运行时会自动下载，
# 无需入库，因此这里不放行，继续由第 6 节的 *.pt 规则忽略。

# ----- 9.2 部署所需的两个自训练权重 ------------------------------------------
# runs/ 下先整体排除、再逐级放行，最终只保留两个 best.pt
runs/*
!runs/detect/
runs/detect/*
!runs/detect/trains/
runs/detect/trains/*
!runs/detect/trains/train-TrafficSignal/
!runs/detect/trains/train-FacialExpression/

runs/detect/trains/train-TrafficSignal/*
!runs/detect/trains/train-TrafficSignal/weights/
runs/detect/trains/train-TrafficSignal/weights/*
!runs/detect/trains/train-TrafficSignal/weights/best.pt

runs/detect/trains/train-FacialExpression/*
!runs/detect/trains/train-FacialExpression/weights/
runs/detect/trains/train-FacialExpression/weights/*
!runs/detect/trains/train-FacialExpression/weights/best.pt

# ----- 9.3 项目展示图 ---------------------------------------------------------
!screenshots/
!screenshots/*.jpg
!screenshots/*.jpeg
!screenshots/*.png
!screenshots/*.gif
!screenshots/*.webp
